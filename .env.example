# Configuration Aurion
# Copiez ce fichier en .env et remplissez les valeurs

# URL de connexion Supabase (Postgres)
# Format : postgresql://postgres:[MOT_DE_PASSE]@[HOST]:[PORT]/postgres
# Exemple : postgresql://postgres:your_password@db.abc123.supabase.co:5432/postgres
DATABASE_URL=

# Paper trading: solde initial et hypothèses de coûts
AURION_SIMULATION_SOLDE_USDT=10000
AURION_FRAIS_TAKER=0.001
AURION_SLIPPAGE_ESTIME=0.0005
AURION_LIMITE_ORDRE_USDT=100

# À renseigner seulement si MODE_SIMULATION est explicitement mis à False dans broker.py
BINANCE_API_KEY=
BINANCE_API_SECRET=
